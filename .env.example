# ---------------------------------------------------------------------------
# OptiFlow Instagram Outbound Engine - environment template
# Copy to .env (local tooling) and/or create matching n8n credentials.
# Nothing in this repo reads secrets directly from code: every provider goes
# through lib/providers/* so a key can be swapped without touching logic.
# ---------------------------------------------------------------------------

# --- Datastore (source of truth) -------------------------------------------
SUPABASE_URL=https://YOUR-PROJECT.supabase.co
SUPABASE_SERVICE_ROLE_KEY=            # server-side only, never in a browser
SUPABASE_ANON_KEY=                    # used by the approval console
DATABASE_URL=postgresql://postgres:PASSWORD@db.YOUR-PROJECT.supabase.co:5432/postgres

# --- AI layer ---------------------------------------------------------------
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5
ANTHROPIC_MODEL_HEAVY=claude-opus-5   # research + reply handling
ANTHROPIC_MAX_TOKENS=2000

# --- Lead discovery (replaceable) ------------------------------------------
DISCOVERY_PROVIDER=apify
APIFY_TOKEN=
APIFY_GOOGLE_MAPS_ACTOR=compass~crawler-google-places
APIFY_INSTAGRAM_PROFILE_ACTOR=apify~instagram-profile-scraper
APIFY_INSTAGRAM_SEARCH_ACTOR=apify~instagram-search-scraper

# --- Enrichment (replaceable) ----------------------------------------------
ENRICHMENT_PROVIDER=apollo
APOLLO_API_KEY=
ENRICHMENT_FALLBACK_PROVIDER=website_scrape

# --- Instagram --------------------------------------------------------------
# Cold outbound DMs are HUMAN-SENT from the approval console (see docs/05).
# These credentials only cover inbound reply webhooks / conversation reads for
# an eligible Instagram Professional account via the official Graph API.
INSTAGRAM_MODE=manual                 # manual | graph_api
IG_APP_ID=
IG_APP_SECRET=
IG_PAGE_ACCESS_TOKEN=
IG_BUSINESS_ACCOUNT_ID=
IG_WEBHOOK_VERIFY_TOKEN=

# --- Optional mirror --------------------------------------------------------
SHEETS_ENABLED=false
GOOGLE_SHEETS_SPREADSHEET_ID=
GOOGLE_SHEETS_TAB=Qualified Leads

# --- n8n --------------------------------------------------------------------
N8N_BASE_URL=https://n8n.example.com
N8N_WEBHOOK_SECRET=                   # shared secret for internal webhook calls
N8N_TIMEZONE=America/Los_Angeles
