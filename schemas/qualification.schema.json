{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "optiflow/qualification",
  "title": "AI qualification output",
  "type": "object",
  "required": ["ai_scores", "reason", "potential_pain_points", "recommended_service", "recommended_outreach_angle", "decision_maker_found", "disqualify"],
  "additionalProperties": false,
  "properties": {
    "ai_scores": {
      "type": "object",
      "required": ["niche_fit", "business_quality", "website_quality", "cx_need", "outreach_potential"],
      "additionalProperties": false,
      "properties": {
        "niche_fit": { "type": "number", "minimum": 0, "maximum": 100 },
        "business_quality": { "type": "number", "minimum": 0, "maximum": 100 },
        "website_quality": { "type": "number", "minimum": 0, "maximum": 100 },
        "cx_need": { "type": "number", "minimum": 0, "maximum": 100 },
        "outreach_potential": { "type": "number", "minimum": 0, "maximum": 100 }
      }
    },
    "reason": { "type": "string", "minLength": 30, "maxLength": 1200 },
    "potential_pain_points": { "type": "array", "minItems": 1, "maxItems": 6, "items": { "type": "string", "minLength": 10, "maxLength": 300 } },
    "recommended_service": { "type": "string", "minLength": 3, "maxLength": 120 },
    "recommended_outreach_angle": { "type": "string", "minLength": 2, "maxLength": 60 },
    "decision_maker_found": { "type": "boolean" },
    "confidence": { "type": "number", "minimum": 0, "maximum": 1 },
    "disqualify": { "type": "boolean" },
    "disqualify_reason": { "type": ["string", "null"], "maxLength": 300 }
  }
}
