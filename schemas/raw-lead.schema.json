{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "optiflow/raw_lead",
  "title": "RawLead - the contract every discovery provider must satisfy",
  "description": "Only business_name or instagram_handle is strictly required; everything else is best effort. lib/normalize.js maps provider-specific field names onto this shape, so a replacement scraper only has to produce something normalizeRawLead() can read.",
  "type": "object",
  "anyOf": [{ "required": ["business_name"] }, { "required": ["instagram_handle"] }],
  "properties": {
    "business_name": { "type": ["string", "null"] },
    "instagram_handle": { "type": ["string", "null"] },
    "instagram_url": { "type": ["string", "null"] },
    "website": { "type": ["string", "null"] },
    "email": { "type": ["string", "null"] },
    "phone": { "type": ["string", "null"] },
    "city": { "type": ["string", "null"] },
    "state": { "type": ["string", "null"] },
    "country": { "type": ["string", "null"] },
    "postal_code": { "type": ["string", "null"] },
    "address": { "type": ["string", "null"] },
    "latitude": { "type": ["number", "null"] },
    "longitude": { "type": ["number", "null"] },
    "category": { "type": ["string", "null"] },
    "bio": { "type": ["string", "null"] },
    "website_description": { "type": ["string", "null"] },
    "products_services": { "type": ["array", "string", "null"] },
    "ig_followers": { "type": ["number", "string", "null"] },
    "ig_following": { "type": ["number", "string", "null"] },
    "ig_posts": { "type": ["number", "string", "null"] },
    "ig_is_business": { "type": ["boolean", "null"] },
    "ig_is_private": { "type": ["boolean", "null"] },
    "ig_is_verified": { "type": ["boolean", "null"] },
    "ig_last_post_at": { "type": ["string", "null"] },
    "place_id": { "type": ["string", "null"] },
    "source": { "type": ["string", "null"] },
    "search_term": { "type": ["string", "null"] }
  }
}
