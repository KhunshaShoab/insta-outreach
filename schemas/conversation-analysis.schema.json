{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "optiflow/conversation_analysis",
  "title": "Conversation analysis output",
  "type": "object",
  "required": ["summary", "current_state", "recommended_stage", "recommended_next_step"],
  "additionalProperties": false,
  "properties": {
    "summary": { "type": "string", "minLength": 20, "maxLength": 900 },
    "current_state": { "type": "string", "enum": ["awaiting_us", "awaiting_them", "stalled", "resolved"] },
    "buying_signals": { "type": "array", "maxItems": 10, "items": { "type": "string", "maxLength": 300 } },
    "risk_signals": { "type": "array", "maxItems": 10, "items": { "type": "string", "maxLength": 300 } },
    "open_questions": { "type": "array", "maxItems": 10, "items": { "type": "string", "maxLength": 300 } },
    "commitments": {
      "type": "array",
      "maxItems": 10,
      "items": {
        "type": "object",
        "required": ["who", "what"],
        "additionalProperties": false,
        "properties": {
          "who": { "type": "string", "enum": ["us", "them"] },
          "what": { "type": "string", "maxLength": 300 },
          "fulfilled": { "type": "boolean" }
        }
      }
    },
    "objections_raised": { "type": "array", "maxItems": 10, "items": { "type": "string", "maxLength": 120 } },
    "recommended_stage": { "type": "string", "enum": ["CONVERSATION", "INTERESTED", "NURTURE", "NOT_INTERESTED", "CLOSED"] },
    "recommended_next_step": { "type": "string", "minLength": 10, "maxLength": 500 },
    "stalled": { "type": "boolean" },
    "confidence": { "type": "number", "minimum": 0, "maximum": 1 }
  }
}
