{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "optiflow/research",
  "title": "AI business research brief",
  "type": "object",
  "required": ["business_summary", "what_they_sell", "cx_needs", "operational_pain_points", "specific_observations", "why_optiflow_relevant", "recommended_service", "recommended_angle", "confidence"],
  "additionalProperties": false,
  "properties": {
    "business_summary": { "type": "string", "minLength": 60, "maxLength": 1500 },
    "what_they_sell": { "type": "string", "minLength": 5, "maxLength": 600 },
    "who_their_customers_are": { "type": ["string", "null"], "maxLength": 600 },
    "instagram_focus": { "type": ["string", "null"], "maxLength": 600 },
    "business_model": { "type": ["string", "null"], "enum": ["local_service", "ecommerce_brand", "hybrid", null] },
    "likely_decision_maker": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "name": { "type": ["string", "null"], "maxLength": 120 },
        "role": { "type": ["string", "null"], "maxLength": 120 },
        "why": { "type": ["string", "null"], "maxLength": 600 }
      }
    },
    "cx_needs": { "type": "array", "minItems": 1, "maxItems": 6, "items": { "type": "string", "minLength": 10, "maxLength": 300 } },
    "operational_pain_points": { "type": "array", "minItems": 1, "maxItems": 6, "items": { "type": "string", "minLength": 10, "maxLength": 300 } },
    "specific_observations": { "type": "array", "minItems": 1, "maxItems": 6, "items": { "type": "string", "minLength": 10, "maxLength": 400 } },
    "why_optiflow_relevant": { "type": "string", "minLength": 30, "maxLength": 900 },
    "recommended_service": { "type": "string", "minLength": 3, "maxLength": 120 },
    "recommended_angle": { "type": "string", "minLength": 2, "maxLength": 60 },
    "confidence": { "type": "number", "minimum": 0, "maximum": 1 },
    "evidence": { "type": "array", "maxItems": 20, "items": { "type": "string", "maxLength": 80 } }
  }
}
