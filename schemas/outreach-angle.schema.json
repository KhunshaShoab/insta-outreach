{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "optiflow/outreach_angle",
  "title": "Outreach angle selection output",
  "type": "object",
  "required": ["angle_id", "why_this_angle", "confidence"],
  "additionalProperties": false,
  "properties": {
    "angle_id": { "type": "string", "minLength": 2, "maxLength": 60 },
    "why_this_angle": { "type": "string", "minLength": 20, "maxLength": 600 },
    "supporting_observation": { "type": ["string", "null"], "maxLength": 400 },
    "runner_up_angle_id": { "type": ["string", "null"], "maxLength": 60 },
    "confidence": { "type": "number", "minimum": 0, "maximum": 1 }
  }
}
