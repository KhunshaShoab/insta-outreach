{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "optiflow/outreach_message",
  "title": "Personalised Instagram DM variations",
  "type": "object",
  "required": ["variations", "recommended_variation", "outreach_angle", "personalisation_used", "self_check"],
  "additionalProperties": false,
  "properties": {
    "variations": {
      "type": "array",
      "minItems": 2,
      "maxItems": 3,
      "items": {
        "type": "object",
        "required": ["variation", "message"],
        "additionalProperties": false,
        "properties": {
          "variation": { "type": "string", "enum": ["conversational", "professional", "concise"] },
          "message": { "type": "string", "minLength": 20, "maxLength": 900 },
          "char_count": { "type": "number", "minimum": 0 }
        }
      }
    },
    "recommended_variation": { "type": "string", "enum": ["conversational", "professional", "concise"] },
    "recommendation_reason": { "type": ["string", "null"], "maxLength": 400 },
    "outreach_angle": { "type": "string", "minLength": 2, "maxLength": 60 },
    "personalisation_used": { "type": "array", "minItems": 1, "maxItems": 8, "items": { "type": "string", "maxLength": 400 } },
    "self_check": {
      "type": "object",
      "required": ["opens_with_specific_detail", "no_service_list", "ends_with_one_question", "under_max_chars"],
      "additionalProperties": false,
      "properties": {
        "opens_with_specific_detail": { "type": "boolean" },
        "no_service_list": { "type": "boolean" },
        "ends_with_one_question": { "type": "boolean" },
        "under_max_chars": { "type": "boolean" },
        "no_banned_phrases": { "type": "boolean" }
      }
    }
  }
}
