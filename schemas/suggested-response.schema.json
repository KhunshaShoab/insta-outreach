{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "optiflow/suggested_response",
  "title": "AI response assistant output",
  "type": "object",
  "required": ["suggested_response", "reason", "next_action", "requires_human_review"],
  "additionalProperties": false,
  "properties": {
    "suggested_response": { "type": "string", "minLength": 10, "maxLength": 900 },
    "char_count": { "type": "number", "minimum": 0 },
    "reason": { "type": "string", "minLength": 10, "maxLength": 600 },
    "next_action": {
      "type": "string",
      "enum": ["continue_conversation", "answer_question", "send_pricing_context", "route_to_human", "mark_interested", "mark_nurture", "mark_not_interested", "suppress_contact", "redirect_to_named_contact", "no_action"]
    },
    "alternatives": {
      "type": "array",
      "maxItems": 3,
      "items": {
        "type": "object",
        "required": ["message"],
        "additionalProperties": false,
        "properties": {
          "label": { "type": ["string", "null"], "maxLength": 120 },
          "message": { "type": "string", "minLength": 10, "maxLength": 900 },
          "when_to_use": { "type": ["string", "null"], "maxLength": 300 }
        }
      }
    },
    "requires_human_review": { "type": "boolean" },
    "flags": { "type": "array", "maxItems": 10, "items": { "type": "string", "maxLength": 300 } },
    "self_check": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "answers_their_question": { "type": "boolean" },
        "no_invented_facts": { "type": "boolean" },
        "under_900_chars": { "type": "boolean" },
        "matches_their_register": { "type": "boolean" }
      }
    }
  }
}
