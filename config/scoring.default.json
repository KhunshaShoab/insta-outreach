  "penalties": {
    "no_website": 0,
    "no_email_and_no_phone": 0,
    "private_account": 15,
    "link_in_bio_only_aggregator": 0,
    "suspected_reseller": 20
  },
  "priority_map": {
    "HIGH_PRIORITY": "high",
    "QUALIFIED": "medium",
    "REVIEW": "low",
    "NOT_QUALIFIED": "none"
  }
